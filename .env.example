# Copy this file to .env and adjust as needed. docker-compose reads these automatically.

# Create an API key in WebObsidian Settings → API Keys with read, write, and search scopes.
# AGENT_API_KEY=
# AGENT_API_BASE_URL=http://webobsidian:8787/api/v1

# Absolute path (Windows or Linux) to the folder containing project folders
# you want NOVA to be able to search/read, e.g. C:/Users/you/dev or /home/you/dev
NOVA_HOST_PROJECTS_PATH=./host_projects

# Base downloader provides this model. Other supported IDs are listed in nova/config.py.
NOVA_LLM_MODEL=qwen2.5-3b

# Optional: set the Google OAuth token path. Keep it out of the generic data folder.
# GOOGLE_TOKEN_PATH=./persistent_memory/credentials/google_calendar_token.json

# Optional: set this to the timezone in which your Google Calendar events should
# be displayed. Example: Europe/London, Europe/Berlin, America/New_York
# GOOGLE_CALENDAR_TIMEZONE=Europe/London

# Performance tuning (CPU-only defaults)
NOVA_MEM_LIMIT=6g
NOVA_LLM_THREADS=4
NOVA_LLM_THREADS_BATCH=4
NOVA_LLM_BATCH=512
NOVA_LLM_CTX=4096
NOVA_LLM_FLASH_ATTN=true
NOVA_LLM_MLOCK=false
# Set to q8_0 only with flash attention enabled.
# NOVA_LLM_KV_CACHE_TYPE=q8_0
NOVA_LLM_CACHE_MB=512
NOVA_LLM_TEMP_TOOLS=0.1
NOVA_LLM_MAX_TOKENS_CHAT=128
NOVA_LLM_MAX_TOKENS_TOOL=96
NOVA_LLM_CONFIRMATIONS=false
NOVA_THREADS=4
# Keep 0 on first boot so missing faster-whisper / intent assets can download.
# Set to 1 only after preparing all required local model directories.
NOVA_OFFLINE=0
NOVA_HISTORY_TURNS=6
NOVA_PREWARM_MODELS=false
NOVA_MINILM_MODEL_DIR=./models/minilm
# Separate from the legacy whisper.cpp file downloaded into models/whisper.
NOVA_WHISPER_MODEL_DIR=./models/whisper/faster_whisper_model
